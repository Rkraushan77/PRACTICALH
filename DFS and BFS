tree={
    1:[5,4],
    2:[],
    3:[],
    4:[3,6],
    5:[2],
    6:[7],
    7:[]
}
def dfs(start):
    visited=[]
    stack=[start]
    while stack:
        node=stack.pop()
        visited.append(node)
        for child in reversed(tree[node]):
            stack.append(child)
    return visited
print("dfs traversal:",dfs(1))
